[Unit]
Description=TRAceON dummy ECU uProtocol log service
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=traceon-dummy-diag-app
Image=localhost/traceon-dummy-diag-app:dev
Network=host
Environment=APP_ZENOH_LISTEN=tcp/127.0.0.1:7447

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
